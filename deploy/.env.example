# Copy to .env, fill the secrets, then:
#   docker run --gpus all --env-file .env -p 8000:8000 -v udk-data:/data udk-api
# Comments must be on their own lines: docker --env-file keeps anything after "=" as the value.

# --- secrets (required) ---
# Long random string; the website sends it as the X-Service-Token header.
UDK_SERVICE_TOKEN=
# https://<website>/udk-alerts
UDK_WEBHOOK_URL=
# Long random string, shared with the website so it can verify alerts.
UDK_WEBHOOK_SECRET=

# --- detection: the validated English configuration ---
UDK_ENABLE_STT=1
UDK_STT_MODEL=small.en
UDK_ENABLE_PARAKEET=1
# Off: on real voices it never matched a danger clip (0/84), only traffic noise and chants (2026-09-25)
UDK_ENABLE_KWS=0
UDK_ENABLE_SEMANTIC=1
UDK_ENABLE_STT_CONFIDENCE_GATE=1
UDK_ENABLE_SCREAM_DETECTION=1
# On, 4 classes (Screaming, Crying, Whimper, Children shouting): catches 29/57 real distress sounds;
# 0 false alarms on 1.2 h Telugu + English conversation, ~4/h in festival/gameplay noise (2026-09-25)
UDK_ENABLE_SCREAM_TRIGGER=1
UDK_DEVICE=cuda
# Intent veto (intent_gate.py): silences a text alert only when both STTs heard the same words
# and the fine-tuned mDeBERTa is confident they are not distress ("I don't need any help").
# Needs an image built with --build-arg UDK_INTENT_MODEL_REPO=... (deploy/README.md); without the
# model the service warns and runs with the gate off. 0.02 = calibrate_veto.py's pick (2026-09-26).
UDK_INTENT_GATE=/app/models/intent_mdeberta
UDK_INTENT_THRESHOLD=0.02

# --- capacity ---
# start/stop/status calls per minute for the website's token (all its users together).
UDK_RATE_LIMIT_PER_MIN=600

# --- optional production storage (delete these lines for local SQLite + disk under /data) ---
# UDK_DATABASE_URL=postgresql://user:pass@host:5432/udk
# UDK_S3_ENDPOINT=
# UDK_S3_BUCKET=
# UDK_S3_ACCESS_KEY=
# UDK_S3_SECRET_KEY=
