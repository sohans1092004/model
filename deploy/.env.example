# Copy to .env, fill the secrets, then:
#   docker run --gpus all --env-file .env -p 8000:8000 -v udk-data:/data udk-api
# Comments must be on their own lines: docker --env-file keeps anything after "=" as the value.

# --- secrets (required) ---
# Long random string; the website sends it as the X-Service-Token header.
UDK_SERVICE_TOKEN=
# https://<website>/udk-alerts
UDK_WEBHOOK_URL=
# Long random string, shared with the website so it can verify alerts.
UDK_WEBHOOK_SECRET=

# --- detection: the validated English configuration ---
UDK_ENABLE_STT=1
UDK_STT_MODEL=small.en
UDK_ENABLE_PARAKEET=1
# Off: on real voices it never matched a danger clip (0/84), only traffic noise and chants (2026-09-25)
UDK_ENABLE_KWS=0
UDK_ENABLE_SEMANTIC=1
UDK_ENABLE_STT_CONFIDENCE_GATE=1
UDK_ENABLE_SCREAM_DETECTION=1
# On, 4 classes (Screaming, Crying, Whimper, Children shouting): catches 29/57 real distress sounds;
# 0 false alarms on 1.2 h Telugu + English conversation, ~4/h in festival/gameplay noise (2026-09-25)
UDK_ENABLE_SCREAM_TRIGGER=1
UDK_DEVICE=cuda
# Intent veto (intent_gate.py): silences a text alert only when both STTs heard the same words
# and the fine-tuned mDeBERTa is confident they are not distress ("I don't need any help").
# Needs an image built with --build-arg UDK_INTENT_MODEL_REPO=... (deploy/README.md); without the
# model the service warns and runs with the gate off. 0.02 = calibrate_veto.py's pick (2026-09-26).
UDK_INTENT_GATE=/app/models/intent_mdeberta
UDK_INTENT_THRESHOLD=0.02

# --- HOST settings: set in the host's SSM config, never here (remote_deploy.sh ignores them in this file) ---
# UDK_DEVICE, UDK_CUSTOM_UDK_STT_MODEL, UDK_ENABLE_HINDI, UDK_ENABLE_INDIC_EXACT, UDK_HINDI_DEVICE,
# UDK_TEXT_MODELS_DEVICE, UDK_CPU_THREADS. The lines below document them; the GPU host's full block is in
# deploy/README.md ("GPU host").

# --- custom UDK: each user's own phrase (custom_udk.py) ---
# Unset = off. The app sends a user's 4-6 setup recordings to POST /v1/users/{user_id}/custom-udk/refresh.
# A host setting like UDK_DEVICE, so it lives in SSM: medium.en on a GPU, small.en on the CPU host
# (medium takes 11-13 s a segment there). The same model as UDK_STT_MODEL is shared, not loaded twice.
# UDK_CUSTOM_UDK_STT_MODEL=small.en

# --- Hindi (safety_router/, docs/hindi_distress_system.md): a host setting, on only on the GPU host ---
# 1 = per-segment language ID: English only / Hindi only / both (higher decision wins).
# Needs the HF read token (SSM /sakhi/udk/hf-token) at build: the private [B] weights and the gated IndicConformer
# are baked into the image. Enabled but not loadable -> the service refuses to start (and the deploy rolls back).
UDK_ENABLE_HINDI=0
# Optional, a second GPU for its models. One 16 GB T4 fits everything with UDK_TEXT_MODELS_DEVICE=cpu
# (LaBSE, MuRIL and the intent veto on CPU; measured 11.9 GB GPU peak, same decisions, 2026-10-07).
# UDK_HINDI_DEVICE=cuda:1
# UDK_TEXT_MODELS_DEVICE=cpu

# --- Telugu / Tamil / Kannada: per-segment routing like Hindi, IndicConformer, exact or fuzzy phrase match only;
# a match only ever asks "Are you safe?" (never a direct alert). Any subset, e.g. te,ta,kn. Off when unset.
# Needs HF_TOKEN (gated IndicConformer) and a GPU like Hindi.
# UDK_ENABLE_INDIC_EXACT=te,ta,kn
# Optional: a local [B] weights file instead of the pinned HF download.
# UDK_HINDI_WEIGHTS=/app/models/frame_model.pt

# --- capacity ---
# start/stop/status calls per minute for the website's token (all its users together).
UDK_RATE_LIMIT_PER_MIN=600

# --- optional production storage (delete these lines for local SQLite + disk under /data) ---
# UDK_DATABASE_URL=postgresql://user:pass@host:5432/udk
# UDK_S3_ENDPOINT=
# UDK_S3_BUCKET=
# UDK_S3_ACCESS_KEY=
# UDK_S3_SECRET_KEY=
