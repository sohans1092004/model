__pycache__/
*.pyc

# Downloaded/converted model caches -- large, third-party, and fully
# regenerable from the model IDs already in source (stt.py converts on
# first use, separation.py fetches speechbrain's pretrained model) --
# not worth freezing as part of the code snapshot.
indic_ct2_models/
sepformer_cache/
beats_cache/
voxlingua_cache/
ecapa_cache/
tfhub_modules/

# Scratch validation output -- regenerable by re-running the script that
# produced it; the script is the source of truth, not its last log.
*_output.log

# Local runtime state, not project code.
.claude/
